# ==========================================
# SYNORA Backend Environment Configuration
# ==========================================

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage settings (Private local directory outside frontend)
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/synora.db
MAX_DOC_SIZE_MB=20
MAX_AUDIO_SIZE_MB=200

# ------------------------------------------
# Provider Selections (All default to free offline local execution)
# ------------------------------------------
# EMBEDDING_PROVIDER: 'local' (100% offline Scikit-Learn vectorizer, zero-cost), 'gemini'
EMBEDDING_PROVIDER=local

# LLM_PROVIDER: 'local' (grounded extractive synthesizer, zero-cost), 'gemini', 'openai', 'ollama'
LLM_PROVIDER=local

# TRANSLATION_PROVIDER: 'local' (blank manual-review draft), 'indictrans2' (local MT weights), 'gemini' (external API), 'none'
TRANSLATION_PROVIDER=local

# AUDIO_PROVIDER: 'whisper' (requires openai-whisper & ffmpeg on PATH), 'none' (transcripts work 100% offline)
AUDIO_PROVIDER=none

# ------------------------------------------
# External Provider Credentials & Models
# NOTE: Secrets should never be committed to git.
# Document content is ONLY sent to external providers if configured below.
# ------------------------------------------

# Google Gemini (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI / OpenAI-compatible (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ollama (Optional local LLM)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# AI4Bharat IndicTrans2 distilled English-to-Indic model (optional; weights are not included/downloaded)
# Tested demo targets: English -> Tamil, Hindi, Telugu, Kannada, Malayalam, Bengali, and Marathi.
# Model checkpoint: https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
# Set TRANSLATION_PROVIDER=indictrans2 only after dependencies and model weights are installed.
# INDICTRANS2_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
# This tested checkpoint does not provide the other source-language directions.

# Whisper Speech-to-Text (Optional)
# WHISPER_MODEL_SIZE=base
