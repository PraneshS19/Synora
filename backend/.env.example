# ==========================================
# SYNORA Backend Environment Configuration
# ==========================================

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage settings (Private local directory outside frontend)
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/synora.db
MAX_DOC_SIZE_MB=20
MAX_AUDIO_SIZE_MB=200

# ------------------------------------------
# Provider Selections (All default to free offline local execution)
# ------------------------------------------
# EMBEDDING_PROVIDER: 'local' (100% offline Scikit-Learn vectorizer, zero-cost)
EMBEDDING_PROVIDER=local

# LLM_PROVIDER: 'local' (grounded extractive synthesizer, zero-cost), 'openai', 'ollama'
LLM_PROVIDER=local

# TRANSLATION_PROVIDER: 'local' (offline draft management & manual review), 'indictrans2' (AI4Bharat local MT weights), 'none'
TRANSLATION_PROVIDER=local

# AUDIO_PROVIDER: 'whisper' (requires openai-whisper & ffmpeg on PATH), 'none' (transcripts work 100% offline)
AUDIO_PROVIDER=none

# ------------------------------------------
# External Provider Credentials & Models
# NOTE: Secrets should never be committed to git.
# Document content is ONLY sent to external providers if configured below.
# ------------------------------------------

# OpenAI / OpenAI-compatible (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ollama (Optional local LLM)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# AI4Bharat IndicTrans2 (Optional local HuggingFace model)
# Requires ~4GB GPU memory and PyTorch.
# INDICTRANS2_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-1B
# INDICTRANS2_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-1B

# Whisper Speech-to-Text (Local offline STT)
# Requires 'pip install openai-whisper' and FFmpeg on system PATH.
# WHISPER_MODEL_SIZE: 'tiny', 'base' (recommended default), 'small', 'medium', 'large-v3'
# WHISPER_DEVICE: 'auto' (uses CUDA GPU when available, else CPU), 'cuda', 'cpu'
# MAX_AUDIO_MINUTES: max recording duration in minutes (default: 180)
# WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=auto
# MAX_AUDIO_MINUTES=180
